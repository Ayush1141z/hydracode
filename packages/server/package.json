{
  "name": "@hydracode/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cd ../database db:generate"

  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.67",
    "@hono/zod-validator": "^0.8.0",
    "@hydracode/database": "workspace:*",
    "@hydracode/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@sentry/bun": "^10.55.0",
    "@sentry/hono": "^10.55.0",
    "ai": "^6.0.193",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "^1.3.14"
  }
}